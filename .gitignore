# Внутренняя документация
docs/
# Локальные датасеты для калибровки симулятора
datasets/*
# ...кроме energydata, нужен для демо-телеметрии на деплое
!datasets/energydata_complete.csv

# venv для аналитики/extractor (pandas+numpy, не коммитим)
.venv-analysis/

# venv для локального прогона диагностических тетрадок (torch+jupyter, Фаза 5)
.venv-notebooks

# executed-копии тетрадок (генерятся nbconvert при локальном прогоне)
notebooks/*_executed.ipynb
# артефакты диагностики (CSV+PNG+zip раундов, генерятся тетрадками — переносимы)
notebooks/out*
notebooks/*.zip

# Диагностические тетрадки Фазы 5 (проверка теории AE/LSTM) — НЕ в репу.
# В GitHub из notebooks/ идёт только train_colab.ipynb (обучение лёгкой модели) + README.
notebooks/diag_*.ipynb

# Данные для диагностических тетрадок (выгрузки export_training_data, переобучаемы).
ae_train.csv
lstm_train.csv


# Обученные веса ML-моделей (бинарь, переобучаемы; Фаза 4 — train_models).
# Игнорируем СОДЕРЖИМОЕ папки (models/*), а не саму папку — иначе !-исключения ниже
# не работают (git не заходит внутрь полностью игнорированной директории).
iot_hub/apps/telemetry/ml/models/*
# Архив весов, скачанный из Colab (распаковывается в models/, в репо не нужен)
ml_models.zip

# ИСКЛЮЧЕНИЕ (Фаза 4 инкр.6–7): боевые артефакты lstm_lf_resid для 4 ML-устройств
# Render (TEMP-001/004/006/008) коммитим в репо — иначе .onnx не доезжает на Render
# (эфемерный диск, стирается при редеплое). .pt НЕ включаем: на проде инференс через
# ONNX без torch; .pt нужен только локально для переэкспорта/переобучения.
!iot_hub/apps/telemetry/ml/models/lstm_lf_resid__TEMP-001__temperature*
!iot_hub/apps/telemetry/ml/models/lstm_lf_resid__TEMP-004__temperature*
!iot_hub/apps/telemetry/ml/models/lstm_lf_resid__TEMP-006__temperature*
!iot_hub/apps/telemetry/ml/models/lstm_lf_resid__TEMP-008__temperature*
# .pt всё равно исключаем (даже для 4 устройств) — на проде не нужен
iot_hub/apps/telemetry/ml/models/*.pt

# Выгрузки телеметрии для обучения в Colab (Фаза 4 — export_training_data).
training_data.csv
*.training.csv
# CSV с метриками устройств (export_training_data --output train_TEMP-XXX.csv) —
# переобучаемы, в репо не нужны (грузятся вручную в Colab).
train_*.csv


